{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "afivgd.awoostuff",
	"name": "Awoo Stuff",
	"version": "v1.0.0",
	"developer": "AFiVGD",
	"description": "",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"resources": {
		"files": [
			"resources/flea-awoo.mp3"
		],
		"sprites": [
			"resources/flea-guy-idk.jpg"
		]
	},
	"settings": {
		"bool-enable-awoo": {
    		"type": "bool",
    		"name": "Enable The Awoo",
    		"description": "Enable the sound when clicking buttons. bro, it literally says 'enable', WHY WOULD YOU EVEN PRESS THIS BUTTON",
    		"default": true
		},
		"awoo-on": {
			"type": "string",
    		"name": "Awoo On",
    		"description": "When will awoo sounded gagaga bruh on what button event yes",
    		"default": "Activated",
			"one-of": ["Activated", "Selected", "Unselected"]
		},
		"bool-enable-awoo-on-jump": {
    		"type": "bool",
    		"name": "Enable Awoo Jumping",
    		"description": "Enable the sound when jumping",
    		"default": true
		},
		"bool-enable-awoo-jumpscare": {
    		"type": "bool",
    		"name": "Enable Awoo Jumpscare",
    		"description": "Enable the awoo jumpscare when jumping",
    		"default": true
		},
		"add-awoo-to-end-text": {
    		"type": "bool",
    		"name": "Add AWOOnes",
    		"description": "Add 'Awoo' at every text at the end. because why not? :3",
    		"default": false
		},
		"custom-text-at-the-end-text": {
			"type": "string",
			"name": "Text",
			"default": "awoo"
		},
		"custom-button-sound-volume": {
			"type": "float",
			"name": "Volume",
			"description": "How loud the custom sound is, WHY NOTTTTT?? :3",
			"default": 1,
			"min": 0,
			"max": 10,
			"control": {
				"arrows": true,
				"arrow-step": 0.01,
				"big-arrows": true,
				"big-arrow-step": 0.05,
				"slider": true,
				"slider-step": 0.005,
				"input": true
    		}
		},
		"custom-audio-path": {
			"type": "file",
			"name": "Audio File",
			"default": "{mod_resources_dir}/flea-awoo.mp3",
			"control": {
				"dialog": "open",
				"filters": [
					{
						"files": ["*.mp3", "*.wav", "*.ogg"],
						"description": "Audio file"
					}
				]
			}
		},
		"flea-jumpscare-img": {
			"type": "file",
			"name": "Image Jumpscare",
			"default": "{mod_resources_dir}/flea-guy-idk.jpg",
			"control": {
				"dialog": "open",
				"filters": [
					{
						"files": ["*.png", "*.jpg", "*.jpeg", "*.orwhateveraslongitsanimagefile"],
						"description": "Image File"
					}
				]
			}
		}
	}
}
